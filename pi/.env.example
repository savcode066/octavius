# Copy to .env or run install.sh. Never commit a real key.
OCTAVIUS_OMNI_ENABLED=1
YIBU_API_KEY=
OCTAVIUS_OMNI_MODEL=qwen3.5-omni-flash
OCTAVIUS_SERIAL_PORT=auto
OCTAVIUS_SIMULATE=0
OCTAVIUS_LOG_LEVEL=INFO
# install.sh generates a pairing code and session secret if absent.
# Pick up / put down. Claw is inverted: higher angle = more open.
# Width->claw angle is a straight line through these two measured points.
OCTAVIUS_CLAW_NARROW_CM=7
OCTAVIUS_CLAW_NARROW_ANGLE=80
OCTAVIUS_CLAW_WIDE_CM=9
OCTAVIUS_CLAW_WIDE_ANGLE=85
# Extra degrees to close past the calibrated angle for a firmer grip.
OCTAVIUS_GRIP_MARGIN_DEG=0
OCTAVIUS_PICKUP_PITCH=0
OCTAVIUS_PUTDOWN_PITCH=110
OCTAVIUS_CLAW_OPEN_ANGLE=110
