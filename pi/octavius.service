[Unit]
Description=Octavius control center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=octavius
WorkingDirectory=/home/octavius/pi
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/octavius/pi/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 60 --bind 0.0.0.0:5000 --certfile /home/octavius/pi/certs/server.crt --keyfile /home/octavius/pi/certs/server.key app:app
UMask=0077
NoNewPrivileges=true
SupplementaryGroups=dialout
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
